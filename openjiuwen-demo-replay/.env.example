# 转账前保镖端口。复制为本目录 .env 后按需修改。
# 不复制、不导出时：前端 5174，后端 5180。
# 已在 shell 里 export / $env: 的变量优先于本文件。
# live_server.py 会读取本文件里尚未导出的下列变量（也会读 spike/.env）。
# 改完要同时重启 `npm run dev` 和 `python live_server.py`。

# 页面端口（Vite dev / preview）。被占用就换成空闲端口。
OPENJIUWEN_DEMO_PORT=5174

# 现场会商 API 端口（live_server.py）。页面默认请求这个端口。
OPENJIUWEN_LIVE_PORT=5180

# 可选。页面请求的完整基址。不设则是 http://127.0.0.1:$OPENJIUWEN_LIVE_PORT
# 设了就必须和 live_server 实际监听的地址一致，否则现场会商连不上。
# VITE_LIVE_BASE=http://127.0.0.1:5180

# 可选。浏览器源。不设则是 http://127.0.0.1:$OPENJIUWEN_DEMO_PORT
# 必须和地址栏里的协议、主机、端口一致（127.0.0.1 与 localhost 不算同一个源）。
# OPENJIUWEN_LIVE_CORS=http://127.0.0.1:5174

# 可选。只影响冒烟脚本打到哪；不改变 live_server 的监听端口。
# OPENJIUWEN_LIVE_BASE=http://127.0.0.1:5180

# 后端只允许本机。不要改成局域网地址。
# OPENJIUWEN_LIVE_HOST=127.0.0.1
